// app.rc - ไฟล์ resource สำหรับฝัง icon + version info เข้าไปในตัว .exe
// IDI_ICON1 คือ ID ของ icon ที่จะอ้างอิงในโค้ด C (ต้องตรงกับใน .c)

#define IDI_ICON1 101

IDI_ICON1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,2
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LBS"
            VALUE "FileDescription", "MachineInfoGUI Application"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "MachineInfoGUI.exe"
            VALUE "LegalCopyright", "copyright © 2026 LBS"
            VALUE "OriginalFilename", "MachineInfoGUI.exe"
            VALUE "ProductName", "MachineInfoGUI"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END